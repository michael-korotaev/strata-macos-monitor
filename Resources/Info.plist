<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>StrataMonitor</string>
    <key>CFBundleDisplayName</key>
    <string>Strata Monitor</string>
    <key>CFBundleExecutable</key>
    <string>StrataMonitor</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.michael-korotaev.strata-monitor</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Меню-барное приложение: без иконки в Dock и без окна приложения. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>MIT License · Michael Korotaev</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Strata Monitor опрашивает ваш сервер Strata в локальной сети, чтобы показать скорость генерации и состояние видеокарты.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Сервер Strata отдаёт метрики по обычному HTTP в локальной сети, без TLS. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
